# Clement 12B — Macedonian LLM (Gemma-4-12B lineage)
# Template matches the training render byte-for-byte: plain turns,
# system folded into first user turn, stop at <turn|>.
FROM ./Clement-12B-Q4_K_M.gguf

TEMPLATE """{{ if .System }}<|turn>user
{{ .System }}

{{ .Prompt }}<turn|>
<|turn>model
{{ else }}<|turn>user
{{ .Prompt }}<turn|>
<|turn>model
{{ end }}{{ .Response }}"""

PARAMETER stop <turn|>
PARAMETER temperature 0.7
PARAMETER top_p 0.95
PARAMETER num_ctx 4096
